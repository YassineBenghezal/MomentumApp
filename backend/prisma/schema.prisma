datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  xp        Int      @default(0)
  level     Int      @default(1)
  createdAt DateTime @default(now())

  Habit         Habit[]
  Task          Task[]
  HabitTracking HabitTracking[]
}

enum Frequency {
  DAILY // Fréquence quotidienne
  WEEKLY // Jours spécifiques de la semaine
  MONTHLY // Jours spécifiques du mois
  YEARLY // Jours spécifiques de l'année
  CUSTOM // Nombre de fois sur une période définie
}

enum Status {
  EN_COURS
  COMPLETÉ
  ANNULÉ
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum Category {
  WORK
  PERSONAL
  HEALTH
  FINANCE
  OTHER
}

enum CompletionMode {
  BINARY
  NUMERIC
}

model Habit {
  id             Int            @id @default(autoincrement())
  name           String
  description    String?
  category       Category
  frequency      Frequency
  startDate      DateTime
  endDate        DateTime?
  completionMode CompletionMode
  unit           String?

  // Jours spécifiques
  daysOfWeek  String[] // Jours spécifiques de la semaine
  daysOfMonth String[] // Jours spécifiques du mois
  daysOfYear  DaysOfYear[] // Jours spécifiques de l'année

  // Période pour CUSTOM
  occurrences Int? // Nombre de répétitions
  period      String? // Période de référence (week, month, year)

  reminderTime String?
  tracking     HabitTracking[] // Suivi des habitudes
  userId       Int
  user         User            @relation(fields: [userId], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Task {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  category    Category @default(OTHER)
  priority    Priority @default(MEDIUM)
  deadline    DateTime
  completed   Boolean  @default(false)
  archived    Boolean  @default(false)
  userId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model DaysOfYear {
  id      Int   @id @default(autoincrement())
  habitId Int
  habit   Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  month   Int // Mois (1-12)
  day     Int // Jour (1-31)
}

model HabitTracking {
  id        Int      @id @default(autoincrement())
  habitId   Int
  date      DateTime
  completed Boolean
  value     Float?

  habit  Habit @relation(fields: [habitId], references: [id])
  User   User? @relation(fields: [userId], references: [id])
  userId Int?
}
